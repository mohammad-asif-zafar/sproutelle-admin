# Sproutelle Admin Content Studio - Environment Variables

# Supabase URL (From Supabase Project Settings -> API)
VITE_SUPABASE_URL=https://your-supabase-project-id.supabase.co

# Supabase Anon Public Key (From Supabase Project Settings -> API)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional Base Path for GitHub Pages Hosting (default: /sproutelle-admin/)
VITE_BASE_PATH=/sproutelle-admin/
